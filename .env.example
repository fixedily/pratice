DATABASE_URL=sqlite+aiosqlite:///./sensor_data.db

DEFAULT_LLM_PROVIDER=zhipu
DEFAULT_TEXT_MODEL=glm-4.5
DEFAULT_VISION_MODEL=glm-4.5v

DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=sk-xxxxx
OPENAI_API_BASE=
ANTHROPIC_API_KEY=sk-ant-xxxxx
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_TEXT_MODEL=glm-4.5
ZHIPU_VISION_MODEL=glm-4.5v
ZHIPU_OCR_MODEL=glm-ocr

DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding
DASHSCOPE_RERANK_MODEL=qwen3-rerank
DASHSCOPE_VL_RERANK_MODEL=qwen3-vl-rerank

POSTGRES_USER=fault_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fault_detection

DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIM=1024
VECTOR_STORE_BACKEND=pgvector
FAISS_INDEX_PATH=data/faiss_index
OLLAMA_BASE_URL=http://localhost:11434

ENABLE_RERANKER=true
RERANKER_PROVIDER=dashscope
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=20
RERANKER_BATCH_SIZE=32

OCR_PROVIDER=zhipu
IMAGE_ANALYSIS_PROVIDER=zhipu
QUERY_REWRITE_PROVIDER=zhipu

# 检修域 MVP（/api/v1/maintenance）
JWT_SECRET_KEY=please-use-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=7
MAINTENANCE_UPLOAD_DIR=./data/mvp_uploads
ATTACHMENT_SIGN_SECRET=change-me-attachment-hmac

# Redis（验证码 / 登录锁定 / 检索缓存）
# 生产建议保持 REDIS_ENABLED=true，并以 /ready 作为发布验收；本地单进程演示才建议关闭。
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=dachuang
REDIS_SOCKET_TIMEOUT=3
CAPTCHA_TTL_SECONDS=180
LOGIN_FAIL_MAX=5
LOGIN_LOCK_SECONDS=600
LOGIN_FAIL_WINDOW_SECONDS=300

# 邮箱验证码
# EMAIL_PROVIDER=smtp 真实发信；EMAIL_PROVIDER=mock 本地/CI 调试，不真实发送邮件。
# SMTP_PASSWORD 为邮箱服务商授权码或应用专用密码，不要提交真实值；.env 不应提交到 Git。
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_FROM_NAME=FaultDiag 运维管理后台
SMTP_USE_SSL=true

# 常见 SMTP 示例：
# QQ 邮箱：SMTP_HOST=smtp.qq.com, SMTP_PORT=465, SMTP_USE_SSL=true
# 163 邮箱：SMTP_HOST=smtp.163.com, SMTP_PORT=465, SMTP_USE_SSL=true
# Gmail：SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_SSL=false  # 使用 STARTTLS，需要应用专用密码
# 企业邮箱：例如 SMTP_HOST=smtp.exmail.qq.com 或 smtp.your-company.com，SMTP_PORT/SMTP_USE_SSL 按服务商要求填写
ENABLE_SEARCH_CACHE=true
SEARCH_CACHE_TTL=300
SEARCH_CACHE_MAXSIZE=1000
